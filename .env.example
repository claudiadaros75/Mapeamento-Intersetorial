# Copie para .env (que e ignorado pelo git) e preencha com os seus tokens.
# Os mesmos valores vao, no GitHub, em Settings > Secrets and variables >
# Actions > aba *Secrets* (nunca na aba Variables).
#
# Token do sandbox.zenodo.org (testes, DOI ficticio)
ZENODO_SANDBOX_TOKEN=
# Token do zenodo.org (DOI real)
ZENODO_TOKEN=
