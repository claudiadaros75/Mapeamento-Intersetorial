# -------------------------------------------------------------
# Dados do IBGE
# -------------------------------------------------------------
# Tudo em data/ e reproduzivel pelos scripts, entao o que for grande
# demais para o repositorio fica de fora.

# Shapefiles do FTP (~350 MB) - use scripts/download_mmd_2024.py
data/*.zip
data/*.part
# Conteudo extraido dos shapefiles
data/BR_*_2024/

# Malhas em qualidade maxima (a municipal sozinha tem 64 MB) - use
# scripts/ibge_malha_municipal__baixar_dados_formato_geojson.py
data/geojson/*_maxima.geojson

# Versionadas (leves o bastante para o GitHub Pages):
#   data/geojson/*_minima.geojson
#   data/geojson/*_intermediaria.geojson

